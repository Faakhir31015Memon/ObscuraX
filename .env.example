# Copy this file to .env. Hostinger: enable "Show hidden files" in File Manager.
#
# Local XAMPP:     APP_ENV=local       APP_DEBUG=true    APP_URL=
# Hostinger:       APP_ENV=production  APP_DEBUG=false   APP_URL=https://yourdomain.com
APP_NAME=ObscuraX
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Asia/Karachi
APP_KEY=change-this-to-a-random-32-char-string

# Database credentials are NOT stored here.
# Edit config/db.php (copy config/db.example.php if it does not exist).

MAIL_DRIVER=log
MAIL_FROM=noreply@obscurax.local
MAIL_FROM_NAME=ObscuraX
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

UPLOAD_MAX_IMAGE_MB=5
SESSION_LIFETIME_MINUTES=120
